# BUILD DA IMAGEM

PYTHON_VERSION=3.12

# cu118 | cu121 | cu124 | cu126 | cu128 | cpu
TORCH_CUDA=cu126

# vazio = mais recente para o TORCH_CUDA
TORCH_VERSION=
TORCHVISION_VERSION=

# RECURSOS DO CONTAINER

# all, 1, 2, ...
GPU_COUNT=all
# memória compartilhada para os workers do dataloader
SHM_SIZE=8gb
# dono dos arquivos gerados no host (id -u)
UID=1000
# (id -g)
GID=1000
# pasta no host com os datasets
DATASET_HOST_DIR=../Dateset

#  Dataset 
DATASET_NAME=Torso21
VAL_RATIO=0.20
TEST_RATIO=0.10
FORCE_SINGLE_CLASS=false
SINGLE_CLASS_NAME=object
SINGLE_CLASS_ID=0

# Treinamento
# rtdetr-l | rtdetr-x (.pt)
MODEL_VERSION=rtdetr-l.pt
EPOCHS=60

# -1 = automático pela memória da GPU
BATCH_SIZE=8
IMAGE_SIZE=640
PATIENCE=20

# vazio = automático; 0 | 0,1 | cpu
DEVICE=
WORKERS=8
SEED=0

# SGD | Adam | AdamW | RMSProp | auto
OPTIMIZER=auto
LR0=0.01
LRF=0.01
MOMENTUM=0.937
WEIGHT_DECAY=0.0005

# Saída
# vazio = RTDETR_Treinamentos_<DATASET_NAME>
PROJECT_DIR=
# vazio = teste_<DATASET_NAME>
RUN_NAME=

# Etapas
FIX_DATASET=true
DO_TRAIN=true
DO_ANALYSIS=true

